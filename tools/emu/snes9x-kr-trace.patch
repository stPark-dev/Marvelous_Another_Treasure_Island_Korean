new file mode 100644
index 0000000..6f9971d
--- /dev/null
+++ b/kr_trace.h
@@ -0,0 +1,15 @@
+#ifndef KR_TRACE_H
+#define KR_TRACE_H
+#include "port.h"
+struct KrEvent { uint32 kind, pbpc, addr, val; uint16 a, x, y, d, s; uint8 db, p, pad0, pad1; uint32 extra; };
+extern uint32 kr_rlo, kr_rhi, kr_wlo, kr_whi, kr_xlo, kr_xhi, kr_on, kr_plo, kr_phi;
+void kr_log(uint32 kind, uint32 addr, uint32 val, uint32 extra);
+void kr_log_sa1(uint32 kind, uint32 addr, uint32 val, uint32 extra);
+#define KR_PCOK (Registers.PBPC >= kr_plo && Registers.PBPC <= kr_phi)
+#define KR_READ(addr, v) do { if ((kr_on & 1) && (uint32)(addr) >= kr_rlo && (uint32)(addr) <= kr_rhi && KR_PCOK) kr_log(0, addr, v, 0); } while (0)
+#define KR_WRITE(addr, v) do { if ((kr_on & 1) && (uint32)(addr) >= kr_wlo && (uint32)(addr) <= kr_whi && KR_PCOK) kr_log(1, addr, v, 0); } while (0)
+#define KR_SA1PCOK (kr_sa1_pc() >= kr_plo && kr_sa1_pc() <= kr_phi)
+uint32 kr_sa1_pc(void);
+#define KR_SA1_READ(addr, v) do { if ((kr_on & 2) && (uint32)(addr) >= kr_rlo && (uint32)(addr) <= kr_rhi && KR_SA1PCOK) kr_log_sa1(4, addr, v, 0); } while (0)
+#define KR_SA1_WRITE(addr, v) do { if ((kr_on & 2) && (uint32)(addr) >= kr_wlo && (uint32)(addr) <= kr_whi && KR_SA1PCOK) kr_log_sa1(5, addr, v, 0); } while (0)
+#endif
